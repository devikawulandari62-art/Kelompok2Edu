  (function() {
    const products = [
      { name: 'Happy Cheese', mood: 'Happy → Cheese', emoji: '🧀', price: 5000, priceSharing: 10000, category: 'cheese' },
      { name: 'Hype Spicy', mood: 'Hype → Spicy', emoji: '🌶️', price: 5000, priceSharing: 10000, category: 'spicy' },
      { name: 'Chill Seaweed', mood: 'Chill → Seaweed', emoji: '🌿', price: 5000, priceSharing: 10000, category: 'seaweed' },
      { name: 'Sunny Corn', mood: 'Sunny → Corn', emoji: '🌽', price: 5000, priceSharing: 10000, category: 'corn' },
      { name: 'Bold BBQ', mood: 'Bold → BBQ', emoji: '🍖', price: 5000, priceSharing: 10000, category: 'bbq' },
      { name: 'Happy × Hype (Cheese+Spicy)', mood: 'Happy × Hype', emoji: '🧀🌶️', price: 6000, priceSharing: 11000, category: 'mix' },
      { name: 'Chill × Sunny (Seaweed+Corn)', mood: 'Chill × Sunny', emoji: '🌿🌽', price: 6000, priceSharing: 11000, category: 'mix' },
      { name: 'Bold × Hype (BBQ+Spicy)', mood: 'Bold × Hype', emoji: '🍖🌶️', price: 6000, priceSharing: 11000, category: 'mix' },
    ];

    const grid = document.getElementById('productGrid');
    const priceFilter = document.getElementById('priceFilter');
    const priceDisplay = document.getElementById('priceDisplay');

    function renderProducts(maxPrice) {
      grid.innerHTML = '';
      const filtered = products.filter(p => p.price <= maxPrice);
      if (filtered.length === 0) {
        grid.innerHTML = '<p style="grid-column:1/-1; text-align:center; padding:40px; color:#7a5a4a;">Tidak ada produk dalam rentang harga ini. Geser filter ya! 🌈</p>';
        return;
      }
      filtered.forEach(p => {
        const card = document.createElement('div');
        card.className = 'product-card';
        const priceFormatted = p.price.toLocaleString();
        const sharingFormatted = p.priceSharing.toLocaleString();
        card.innerHTML = `
          <div class="emoji-big">${p.emoji}</div>
          <h4>${p.name}</h4>
          <span class="mood-label">${p.mood}</span>
          <div class="price">Rp ${priceFormatted} <small>Regular</small></div>
          <div style="font-size:0.85rem; color:#7a5a4a; margin:4px 0 6px;">Sharing: Rp ${sharingFormatted} <span style="background:var(--yellow-soft); padding:1px 8px; border-radius:40px; font-weight:600;">+1K mix</span></div>
          <a href="https://wa.me/6283841394780?text=Halo%20CHILLUS!%20Saya%20mau%20pesan%20${encodeURIComponent(p.name)}%20(${p.mood})%20-%20Regular%20Rp${p.price}" target="_blank" class="btn-wa"><i class="fab fa-whatsapp"></i> Pesan</a>
        `;
        grid.appendChild(card);
      });
    }

    function updateFilter() {
      const val = parseInt(priceFilter.value);
      priceDisplay.innerText = `≤ Rp ${val.toLocaleString()}`;
      renderProducts(val);
    }

    priceFilter.addEventListener('input', updateFilter);
    renderProducts(15000);
  })();
</script>
</body>
</html>
